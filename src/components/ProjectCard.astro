---
import { X, Zap } from "@lucide/astro";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
    image: ImageMetadata;
    title: string;
    description: string;
    url: string;
    private: boolean;
    id: string;
    technologies: string[];
    challenges: string;
}

const {
    image,
    title,
    description,
    url,
    private: isPrivate,
    id,
    technologies,
    challenges
}: Props = Astro.props;

const dialogId = `dialog-${id}`;
---

<div class="flex flex-col bg-primary/5 rounded-xl border border-primary/10 overflow-hidden">
    <!-- Imagen de la card -->
    <div>
        <Image
            height={200}
            src={image}
            alt={`imagen de ${title}`}
            class="w-full rounded-t-xl"
        />
    </div>

    <!-- Contenido de la card -->
    <div class="p-5 flex flex-col flex-1">
        <div>
            <h2 class="text-center font-mono text-lg mb-2">
                {title}
            </h2>

            <p>
                {description.slice(0, 100)}{description.length > 100 ? "..." : ""}
            </p>
        </div>

        <div class="mt-auto">
            <hr class="my-2 text-primary/20" />

            <div class="flex justify-evenly gap-1 mt-2">
                {
                    !isPrivate && (
                        <a
                            href={url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:underline"
                        >
                            Visitar
                        </a>
                    )
                }

                <button
                    command="show-modal"
                    commandfor={dialogId}
                    class="hover:underline"
                >
                    Ver más
                </button>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <dialog id={dialogId}>
        <div class="max-h-[85vh] overflow-y-auto">
            <!-- Imagen -->
            <div class="relative aspect-video w-full overflow-hidden">
                <Image
                    src={image}
                    alt={`imagen de ${title}`}
                    class="h-full w-full object-cover rounded-2xl"
                />

                <!-- Degradado -->
                <div
                    class="absolute inset-0 bg-linear-to-t from-slate-950 via-slate-950/20 to-transparent"
                />

                <!-- Botón cerrar -->
                <button
                    command="close"
                    commandfor={dialogId}
                    aria-label="Cerrar"
                    class="absolute right-4 top-4 !m-0 flex size-9 items-center justify-center rounded-full border border-white/10 bg-slate-950/60 p-0 text-slate-300 backdrop-blur-sm transition hover:border-white/20 hover:bg-slate-900 hover:text-white"
                >
                    <span class="text-lg leading-none">
                        <X />
                    </span>
                </button>
            </div>

            <!-- Información -->
            <div class="p-6 sm:p-8">
                <!-- Título + descripción -->
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-slate-100 sm:text-3xl">
                        {title}
                    </h2>

                    <p class="mt-3 text-sm leading-7 text-slate-400 sm:text-base">
                        {description}
                    </p>
                </div>

                <!-- Tecnologías -->
                <div class="mt-7">
                    <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
                        Tecnologías
                    </h3>

                    <div class="mt-3 flex flex-wrap gap-2">
                        {
                            technologies.map((technology) => (
                                <span class="rounded-full border border-secondary/20 bg-secondary/10 px-3 py-1.5 text-xs font-medium text-slate-300">
                                    {technology}
                                </span>
                            ))
                        }
                    </div>
                </div>

                <!-- Desafío -->
                {
                    challenges && (
                        <div class="mt-7 border border-secondary/10 bg-secondary/5 p-4 sm:p-5">
                            <div class="flex gap-3">

                                <div>
                                    <h3 class="text-sm font-semibold text-slate-200">
                                        Desafíos en el proyecto
                                    </h3>

                                    <p class="mt-2 text-sm leading-7 text-slate-400">
                                        {challenges}
                                    </p>
                                </div>
                            </div>
                        </div>
                    )
                }

                <!-- Acciones -->
                <div class="mt-8 flex flex-col-reverse gap-3 border-t border-white/5 pt-5 sm:flex-row sm:justify-end">
                    <button
                        command="close"
                        commandfor={dialogId}
                        class="rounded-lg border border-slate-700 px-4 py-2.5 text-sm font-medium text-slate-300 transition hover:border-slate-600 hover:bg-slate-800/60 hover:text-white"
                    >
                        Cerrar
                    </button>

                    {
                        !isPrivate && (
                            <a
                                href={url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="rounded-lg bg-primary px-5 py-2.5 text-center text-sm font-semibold text-slate-950 transition hover:brightness-110"
                            >
                                Visitar proyecto
                            </a>
                        )
                    }
                </div>
            </div>
        </div>
    </dialog>
</div>

<style>
    dialog {
        position: fixed;
        inset: 50% auto auto 50%;

        width: min(90vw, 720px);
        max-height: 85vh;

        margin: 0;
        padding: 0;

        transform: translate(-50%, -50%) scale(0.95);

        border: 1px solid rgb(148 163 184 / 0.15);
        border-radius: 1.25rem;

        background: rgb(8 13 24 / 0.98);
        color: #e2e8f0;

        box-shadow:
            0 25px 80px rgb(0 0 0 / 0.55),
            0 0 0 1px rgb(255 255 255 / 0.02);

        overflow: hidden;

        opacity: 0;

        transition:
            opacity 0.3s ease,
            transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
            overlay 0.4s ease allow-discrete,
            display 0.4s ease allow-discrete;
    }

    dialog[open] {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
    }

    @starting-style {
        dialog[open] {
            opacity: 0;
            transform: translate(-50%, -50%) scale(0.95);
        }
    }

    dialog::backdrop {
        background: rgb(2 6 23 / 0);
        backdrop-filter: blur(0);

        transition:
            background 0.3s ease,
            backdrop-filter 0.3s ease;
    }

    dialog[open]::backdrop {
        background: rgb(2 6 23 / 0.78);
        backdrop-filter: blur(6px);
    }

    :global(body:has(dialog[open])) {
        overflow: hidden;
    }

    dialog > div::-webkit-scrollbar {
        width: 6px;
    }

    dialog > div::-webkit-scrollbar-track {
        background: transparent;
    }

    dialog > div::-webkit-scrollbar-thumb {
        background: rgb(100 116 139 / 0.4);
        border-radius: 999px;
    }

    dialog > div::-webkit-scrollbar-thumb:hover {
        background: rgb(148 163 184 / 0.6);
    }

    @media (max-width: 640px) {
        dialog {
            width: calc(100vw - 1.5rem);
            max-height: 90vh;
            border-radius: 1rem;
        }
    }
</style>
