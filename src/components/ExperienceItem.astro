---
import { ArrowRight } from "@lucide/astro";

const { position, company, fromDateText, toDateText, description, current } =
    Astro.props;
---

<li class="mb-10 ms-4">
    <div
        class:list={[
            { "animate-ping": current },
            "absolute w-3 h-3 bg-secondary rounded-full mt-1.5 -start-1.5",
        ]}
    >
    </div>
    <div class="absolute w-3 h-3 bg-secondary rounded-full mt-1.5 -start-1.5">
    </div>
    <h3 class="text-xl font-semibold text-secondary">{position}</h3>
    <h3 class="text-lg font-semibold font-mono mb-2">{company}</h3>
    <time class="text-sm font-normal leading-none bg-primary/20 px-1"
        >{fromDateText} - {toDateText}</time
    >
    <ul class="my-4 text-base font-normal text-surface list-disc list-inside">
        {description.map((item, index) => (
            <li key={index}>{item}</li>
        ))}
    </ul>
</li>
